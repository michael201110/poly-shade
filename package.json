{
  "name": "poly-shade",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/mod.js --bundle --format=esm --platform=browser --target=es2022 --external:https://* --outfile=0.4.0/main.mod.js",
    "test": "node --test",
    "check": "npm run build && npm test",
    "verify:live": "npm run build && node scripts/verify-live.mjs",
    "verify:replay": "npm run build && node scripts/verify-replay.mjs",
    "verify:temporal": "npm run build && node scripts/verify-temporal-inputs.mjs",
    "verify:upscaling": "npm run build && node scripts/benchmark-upscaling.mjs",
    "verify:webgpu": "npm run build && node scripts/verify-compute-kernel.mjs && node scripts/verify-webgpu.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "three": "0.181.2"
  }
}
